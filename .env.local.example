# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and must never be committed.

# Password required to sign in at /admin and upload a new CSV.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_COOKIE_SECRET=change-me-too

# Optional: override where the local SQLite database file lives.
# Defaults to ./data/rkr.db. Ignored if TURSO_DATABASE_URL is set below.
# DATABASE_PATH=./data/rkr.db

# Optional: point at a remote Turso (libSQL) database instead of a local
# file — used in production. If unset, the app uses the local file above.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Optional: only needed in production (Vercel) to bypass the 4.5MB
# serverless request-body limit for large CSV uploads — the admin page
# uses a direct-to-storage upload instead of posting through our server
# when this is set. Auto-populated by Vercel once a Blob store is attached
# to the project; leave unset for local dev.
# BLOB_READ_WRITE_TOKEN=

# Optional: transactional email via Resend (https://resend.com). When BOTH are
# set, editor invites and password-reset links are emailed automatically. If
# either is missing everything still works — the admin panel shows a copyable
# link to send by hand instead.
#
# Setup:
#   1. Create a free Resend account.
#   2. Add and verify your sending domain (Domains -> Add Domain, then add the
#      DNS records it shows). Until a domain is verified, Resend only delivers
#      to the account owner's own address.
#   3. Create an API key (API Keys -> Create) and put it in RESEND_API_KEY.
#   4. Set INVITE_FROM_EMAIL to an address AT the verified domain. It accepts a
#      display name: "Roots Knotty Roots <invites@rootsknottyroots.org>".
#   5. Add both in Vercel -> Project -> Settings -> Environment Variables, then
#      redeploy. Verify with Admin -> Email -> "Send Test".
# RESEND_API_KEY=
# INVITE_FROM_EMAIL=

# Optional: where contact-form messages are emailed. Defaults to the
# compiler's address in lib/contact.ts. Messages are always stored in the
# database too (Admin -> Contact messages), so none are lost if email fails.
# CONTACT_EMAIL=
